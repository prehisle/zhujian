# 依赖 / 构建产物 / Tauri 自动生成 —— 按目录名通配,任意深度都命中(607 起)。
# ⛔ 别改回逐工程列的形:七个独立 crate(刻意不建 workspace,Cargo.lock 各自提交)每加一只
# 就要多列一行,漏一行 `git add -A` 就开始吞 target/(2026-08-23 真栽过:1.6 GB 松散对象、一次 add 卡满 2 分钟)。
# 已核:通配不覆盖任何已跟踪路径(`git ls-files -i -c --exclude-standard` 为空)。
node_modules/
dist/
target/
**/gen/schemas/

# 安卓端(P4-b):gradle 分发 zip(137MB,services.gradle.org 被墙,从腾讯镜像下载后
# 放这里供 wrapper file:// 引用)不进 git
/android/gradle-*.zip

# 鸿蒙端(OH-c)
# HAP 工程的构建产物与本机件(hvigor 缓存 / 编出来的 .so / DevEco 本地配置)
/ohos/src-tauri/gen/ohos/.hvigor
/ohos/src-tauri/gen/ohos/oh_modules
/ohos/src-tauri/gen/ohos/local.properties
/ohos/src-tauri/gen/ohos/entry/build
/ohos/src-tauri/gen/ohos/entry/.cxx
/ohos/src-tauri/gen/ohos/entry/oh_modules
/ohos/src-tauri/gen/ohos/entry/libs
# ⛔ 签名材料绝不进 git(照安卓 keystore.properties 那条先例):作者的 .p12/.cer/.p7b
# 路径与 DevEco 加密口令都在这一份里,仓里那份 build-profile.json5 恒是**未签名形**。
/ohos/src-tauri/gen/ohos/signing.local.json5
# 同族:本机 debug profile 绑的 bundleName(与仓里那个真身份可能不同)也是本机件。
/ohos/src-tauri/gen/ohos/bundle-name.local.txt

# 密钥 / 本地配置(含真实 API key)
.env
.env.*
!.env.example
# 更新签名私钥备份(88):.secrets/ 整目录绝不进 git;私钥丢了发不出更新,见 docs/deploy.md §7
/.secrets/
*.key
*.key.pub

# 侧载/发版 APK 副本(仓根友好名,验收/分发用;产物可重 build,不进 git)
/zhujian_*_aarch64.apk
# 安卓构建统一入口(scripts/build-android.mjs)的干净包副本 + 构建来源标记
# (构建目录外,gradle clean 清不到;产物可重 build,不进 git)
/android/apk-out/

# 本地工作杂物(图标出稿中间产物 / 验收截图等,不进 git)
/work_data/
# 验收现场:真机截图、hilog 全文、构建日志、一次性量测脚本。
# ⛔ **必须整目录忽略,不能只靠 `*.log`** —— 里头是**用户设备的截图**与私有目录清单,
# 而公开仓是从这棵树导出的:一次 `git add -A` 就把它们推到 github 上。
# (2026-08-23 立:此前只有 `*.log` 命中,`.jpeg` / `.txt` 一直是"未忽略"状态,
#  仓里那几处引用它的地方也都写着「⚠ 未入库」——纪律在,闸不在。)
/.zjshots/
# 651:上架包(.app)的落点 —— 打包产物,7 MB 二进制,⛔ 不进仓。
# 留在仓里是因为「改前那只会被下一趟构建冲掉」(memory before-after-artifact-overwritten):
# 每次打完就 cp 一份到这儿并带上版本号,传 AGC 时传这儿这只。
/.zjout/

# desktop-cdp.mjs 真机验收固定 WebView2 profile(钉住 WEBVIEW2_USER_DATA_FOLDER,
# 防止每次带 --remote-debugging-port 启动都在 C:\Windows\SystemTemp 新开 scoped_dir)
/.cdp-profile/
# ui-shots-desktop.mjs 的 profile:与上面同一个防漏理由,另开一份是为了两支能同时跑
# (它每趟起手就删掉重建 ⇒ 明暗/语言/上次视图这些 localStorage 档不会变成隐藏入参)
/.ui-shots-profile/
# 同族:.zjshots/ 里那些一次性探针自起 app 时用的 profile。⚠ 622 实撞过 —— 探针跑完
# 目录还在,一条 `git add -A` 把 **155 个文件**(含 BrowserMetrics / Crashpad)扫进提交,
# 而公开仓是从这棵树导出的。⛔ 别指望「跑完记得删」:那是纪律不是闸。
/.ui-shots-profile-probe/

# 本地数据库 / 临时
*.sqlite3
*.sqlite3-*
*.log

# 编辑器 / 系统
.DS_Store
Thumbs.db

# 机器本地配置/二进制(开源后不随仓分发;本机文件保留在磁盘)
/.cargo/
/e2e/drivers/

# flaky-hunt 的失败输出(临时诊断产物)
tmp-flaky/

# 按需探针存的截图(`e2e/probes/*.e2e.js` 里的 saveScreenshot 落点)。
# ⛔ 与上面 `.zjshots/` 那条同一个形:它们**不是**测试资产、是一次性看图用的产物,
# 而公开仓是从这棵树导出的 —— 一次 `git add -A` 就推上 github(2026-08-28 真的差一步)。
# ⚠ 只忽略 `out-` 前缀,别整个 `*.png`:哪天探针要钉一张**基准图**当断言,那份该进仓。
/e2e/probes/out-*.png

# e2e 期间 app 崩出的 GB 级 core dump(340 实测单轮 4 枚共 22GB;/core.* 锚定仓根,
# 与 /core/ 目录不同形不误伤)
/core.*

# 格式探针的第三方样本(`e2e/probes/format-samples.js` 按需取到这儿)。
# ⛔ 这条不是「杂物」而是**许可证**:HEIC 那份仓里没 LICENSE 不可再分发,AVIF 那份是
# CC-BY-SA-4.0(传染性)—— 而本仓 MIT 且公开。⇒ 样本各自取,不随快照走。
/.fmt-samples/
