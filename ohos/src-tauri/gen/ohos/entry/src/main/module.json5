{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        // ⚠ 651:启动页**刻意不用** `app_icon` —— 那张按华为上架要求换成了「满幅、直角、
        // 不透明」(2026-09-04 驳回:图标存在透明背景 / 单层图为圆角),而启动页底色是
        // 白(暗色档黑),满幅朱红方块压上去就是一块硬边红方块。`start_icon` 是原来那张
        // 圆角带透明的,只服务启动页。⛔ 别图省事把这两处并回同一枚资源。
        "startWindowIcon": "$media:start_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          }
        ]
      }
    ],
    // ⛔ **刻意不声明 `BackupExtensionAbility`,也不带 backup_config.json** ——
    // demo 模板默认把它开着(`allowToBackupRestore: true`),而这正是安卓侧 H2
    // (android-plan §7)明确关死的那道口:库里有 device_id + device_key + k_acc +
    // oplog,**系统备份复活到别机 = 密钥离机 + 同一设备身份双副本**,正撞协议的
    // 分叉冻结模型。安卓那边是 `allowBackup=false` + `fullBackupContent=false` +
    // `dataExtractionRules`;鸿蒙这边的对位就是「压根不声明这个扩展能力」。
    // ⚠ 用户要备份走朱简自己那套**加密备份**(backup-plan),不走系统通道。
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:perm_internet_reason",
        "usedScene": { "when": "always" }
      }
    ]
  }
}
